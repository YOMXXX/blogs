---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/astro/Header.astro';
import Footer from '../components/astro/Footer.astro';
import AuthorCard from '../components/astro/AuthorCard.astro';
import ArticleCTA from '../components/astro/ArticleCTA.astro';
import ArticleCard from '../components/astro/ArticleCard.astro';
import ProgressBar from '../components/react/ProgressBar.tsx';
import GiscusComments from '../components/react/GiscusComments.tsx';
import { COLUMN_LABELS, COLUMN_TAG_COLOR } from '../content/config';
import { readingTime } from '../lib/readingTime';
import AdSlot from '../components/astro/AdSlot.astro';
import JsonLd from '../components/astro/JsonLd.astro';
import { buildArticleSchema, buildBreadcrumbSchema } from '../lib/seo';
import Classic from './templates/Classic.astro';
import Terminal from './templates/Terminal.astro';
import Editorial from './templates/Editorial.astro';
import Dossier from './templates/Dossier.astro';
import Digest from './templates/Digest.astro';
import { resolveTemplate } from '../lib/templates';
import type { TemplateKey } from '../lib/templates';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    column: keyof typeof COLUMN_LABELS;
    pubDate: Date;
    updatedDate?: Date;
    tldr: string;
    faq?: Array<{ q: string; a: string }>;
    author: string;
    tags: string[];
    template?: TemplateKey;
  };
  body: string;
  headings: Array<{ depth: number; slug: string; text: string }>;
  related: Array<{
    slug: string;
    data: {
      title: string;
      description: string;
      column: keyof typeof COLUMN_LABELS;
    };
    body: string;
  }>;
  slug: string;
}

const { frontmatter, body, headings, related, slug } = Astro.props;
const fm = frontmatter;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';
const articleSchema = buildArticleSchema({
  title: fm.title,
  description: fm.description,
  slug,
  pubDate: fm.pubDate,
  updatedDate: fm.updatedDate,
  author: fm.author,
  siteUrl,
  image: `${siteUrl}/og/${slug}.png`,
});
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Home', url: `${siteUrl}/` },
  { name: 'Posts', url: `${siteUrl}/posts` },
  { name: fm.title, url: `${siteUrl}/posts/${slug}` },
]);

const tagColor = COLUMN_TAG_COLOR[fm.column];
const dateStr = fm.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const readingTimeStr = readingTime(body);
const columnLabel = COLUMN_LABELS[fm.column];

const TEMPLATE_COMPONENTS = { classic: Classic, terminal: Terminal, editorial: Editorial, dossier: Dossier, digest: Digest } as const;
const Template = TEMPLATE_COMPONENTS[resolveTemplate(fm.template)];
const templateProps = { frontmatter: fm, headings, slug, tagColor, columnLabel, dateStr, readingTimeStr };
---

<BaseLayout title={fm.title} description={fm.description} ogImage={`/og/${slug}.png`} ogType="article">
  <JsonLd schema={[articleSchema, breadcrumbSchema]} />
  <ProgressBar client:idle />
  <Header />
  <main>
    <Template {...templateProps}><slot /></Template>
    <div class="container tail">
      <AuthorCard name={fm.author} pubDate={fm.pubDate} updatedDate={fm.updatedDate} />

      <ArticleCTA />

      <AdSlot position="end-of-article" slot="9901114747" format="rectangle" />

      {
        related.length > 0 && (
          <section class="related">
            <div class="related-h">// related.json ›</div>
            <div class="related-grid">
              {related.map((r) => (
                <ArticleCard
                  slug={r.slug}
                  title={r.data.title}
                  description={r.data.description}
                  column={r.data.column}
                  readingTimeStr={readingTime(r.body)}
                />
              ))}
            </div>
          </section>
        )
      }
      <GiscusComments slug={slug} client:visible />
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 28px 24px 40px;
  }
  .tail { padding-top: 0; }
  .related { margin-top: 48px; }
  .related-h {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--color-accent-green);
    margin-bottom: 12px;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  @media (max-width: 720px) {
    .related-grid { grid-template-columns: 1fr; }
  }
</style>
